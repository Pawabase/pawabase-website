{
  "name": "pawabase-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/seo/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "skill": "node scripts/skill/bundle.mjs",
    "skill:check": "python3 skill/scripts/check_skill.py --docs ../pawabase-docs",
    "skill:catalog": "python3 skill/scripts/build_catalog.py --docs ../pawabase-docs",
    "seo:images": "node scripts/seo/og.mjs && node scripts/seo/icons.mjs",
    "blog:check": "node scripts/blog/collect.mjs --check"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@tanstack/react-router": "^1.140.0",
    "iconsax-react": "^0.0.8",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.140.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.19.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.1",
    "vite-imagetools": "^12.0.2",
    "yaml": "^2.9.1"
  }
}
